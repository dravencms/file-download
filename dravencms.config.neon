extensions:
    dravencms.fileDownload: Dravencms\FileDownload\DI\FileDownloadExtension

nettrine.orm:
    managers:
        default:
            mapping:
                DravencmsModelFileDownload :
                    type: attributes
                    directories:
                        - %appDir%/../vendor/dravencms/file-download/src/Dravencms/Model/FileDownload/Entities
                    namespace: Dravencms\Model\FileDownload
